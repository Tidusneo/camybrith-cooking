#!/system/bin/sh
# Command of the Camybrith rescue module (spec 007, contracts/cli.md), always run as root:
#   su -c /data/adb/modules/camybrith_secours/camybrith etat
# The logic is in Kotlin (core/backup/RescueCommand.kt, tested), started by app_process: it works
# even if the Camybrith interface is broken or uninstalled. Messages are in French (user-facing).
MODDIR=${0%/*}
if [ "$(id -u)" != 0 ]; then
  echo "À lancer en root : su -c $0 $*"
  exit 2
fi
if [ ! -f "$MODDIR/camybrith.apk" ]; then
  echo "ÉTAT INATTENDU : $MODDIR/camybrith.apk manque. Réinstalle le module (bash outils/secours.sh installer)."
  exit 2
fi
export CLASSPATH="$MODDIR/camybrith.apk"
exec app_process /system/bin app.toque.core.backup.RescueMain "$@"
