<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="app.toque.permission.PILOTER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Mises à jour depuis GitHub et mode « Jumeau numérique » (connexion à un PC). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installation des mises à jour sur un appareil non rooté (Android 8 et plus). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Bouton « Retour à Toque » par-dessus l'appli d'origine (le robot n'a pas de bouton Accueil). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".ToqueApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Camybrith Cooking"
        android:largeHeap="false"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:vmSafeMode="${safeMode}">
        <!-- Version rapide (safeMode false) : l'interface est compilée par Android. Sur le Smart
             (Android 8.1, MT8167), le compilateur a déjà recompilé de travers des fonctions très
             appelées : CompilerWatch le surveille en continu. Version prudente (-Pprudent=true) :
             tout est interprété, comme avant. Le moteur, lui, est piloté par l'appli
             app.toque.pilote, toujours interprétée. -->

        <activity
            android:name=".ui.MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|uiMode"
            android:excludeFromRecents="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran d'accueil du robot. Sur un alias à part pour que le retour à l'appli Lidl
             (module de secours, spec 007) puisse le désactiver sans toucher à l'icône. -->
        <activity-alias
            android:name=".ui.Accueil"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Pilotage : appli à part, app.toque.pilote (dossier pilote/), qui reste interprétée. -->

        <service
            android:name=".recipes.SyncService"
            android:exported="false" />

        <service
            android:name=".ui.ReturnBubble"
            android:exported="false" />

        <receiver
            android:name=".recipes.SyncAlarm"
            android:exported="false" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".update.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".recipes.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
